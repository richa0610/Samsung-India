{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  // Without this, VS Code defaults to its own bundled TypeScript instead of
  // this project's (node_modules/typescript) - the bundled one can't
  // resolve "expo/tsconfig.base" correctly, so every .ts/.tsx file shows
  // phantom "Cannot use JSX" errors that a TS Server restart alone doesn't
  // fix (it just relaunches the same wrong TypeScript instance).
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  // android/ is generated by `expo prebuild` (gitignored; its native code is Kotlin), and
  // node_modules holds Expo's own Gradle plugin builds - neither is a Java project to edit here.
  // Without these, the Java / Gradle extensions (if installed) try to import them as Gradle
  // projects on startup and fill the Problems panel with build-path errors that have nothing to
  // do with the app's real build. To edit native Android code, open android/ in Android Studio.
  "java.import.gradle.enabled": false,
  "gradle.autoDetect": "off"
}
