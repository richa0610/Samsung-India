DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=mmtbtwob_tops

# Required for managed MySQL providers that enforce TLS (e.g. Aiven) - path
# to the CA certificate file from that provider's "Connection Information"
# panel. Leave blank for a plain local MySQL with no TLS.
DB_SSL_CA=./certs/ca.pem

# Generate a real random value for local/prod use, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse this placeholder and never commit the real value.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Must match the port in the frontend EXPO_PUBLIC_API_URL. `0.0.0.0` listens
# on this computer's LAN connection as well as localhost.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Dev-only: when true, re-checking-in for a conference deletes the
# existing attendance row and re-marks it, instead of returning the
# cached record. Set back to false for normal (idempotent) behavior.
ALLOW_ATTENDANCE_RETEST=false

# Google Cloud Vision API key (Face Detection) used for the AI proctoring
# check during assessments. Get one from console.cloud.google.com with
# the Cloud Vision API enabled. Leave blank to disable the check.
FACE_DETECTION_API_KEY=

# Comma-separated list of browser origins allowed to call this API (CORS).
# Native Expo Go / dev-client requests are unaffected. Add your machine's
# LAN IP if you test the web build from another device.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8082
